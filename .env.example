# Copie para variáveis de ambiente no dashboard da Vercel
# (Project Settings → Environment Variables). NUNCA commite este
# arquivo com valores reais preenchidos.

# Servidor SMTP usado para enviar o e-mail do formulário.
# Pode ser o SMTP do Gmail (com "senha de app", não a senha normal),
# ou de um serviço transacional (Resend, SendGrid, Mailgun, etc. —
# recomendado em produção, por entregabilidade e limites mais altos).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=seuemail@gmail.com
SMTP_PASS=sua_senha_de_app

# Para quem o briefing é enviado (opcional — padrão: virtusaga447@gmail.com)
MAIL_TO=virtusaga447@gmail.com

# Trava a API para aceitar requisições apenas do seu domínio publicado.
# Defina depois do primeiro deploy, com a URL real da Vercel.
ALLOWED_ORIGIN=https://seusite.vercel.app
